# 站点
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gxwtf_reading"
# iron-session 加密密钥，≥32 字符，生产环境必须随机生成
SECRET_COOKIE_PASSWORD="reading_session_20261105_please_change_me"
# 广学账号中心
GXACCOUNT_URL="https://account.gxwtf.cn"
# worker 回调密钥，站点与 worker 必须一致
INTERNAL_API_KEY="reading_internal_key_please_change_me"

# ---- worker（可写在同一个 .env 里，也可单独给 systemd 配）----
READING_BASE_URL="http://127.0.0.1:3005"
WHISPER_MODEL="/opt/whisper.cpp/models/ggml-small.bin"
ASR_LOCALE="zh-CN"
VIDEO_WORKDIR="/tmp/reading-worker"
