# 环境变量覆盖示例
# 优先级：环境变量 > config/config.toml > 内置默认值
# 用法：cp .env.example .env 后按需修改；脚本不会自动读取 .env，
#       请在自己的 shell / systemd / 容器里 export。

# ---- vault ----
# Obsidian vault 根目录（必须是真正带 .obsidian 的目录）
MINIS_VAULT=/path/to/vault
# 归档子目录与附件目录
READING_FOLDER=阅读收集
READING_ASSETS=附件

# ---- 待办 ----
# 青蛙todo 分组名，优先精确匹配，其次模糊包含
FROGTODO_CATEGORY=阅读收集

# ---- Notion 镜像（可选、从属）----
# 设为 1 / true / yes 开启；父页面留空则跳过镜像
NOTION_ENABLED=false
NOTION_PARENT_PAGE_ID=

# ---- 视频转写 ----
# 转写临时目录，留空则用 $TMPDIR/reading-collector
VIDEO_WORKDIR=
# 识别语言必须与原声一致：auto / zh-CN / en-US ...
ASR_LOCALE=auto
# 识别后端：whispercpp / apple / whisper（留空自动选）
ASR_BACKEND=whispercpp
WHISPER_MODEL=/opt/whisper.cpp/models/ggml-small.bin

# ---- 其他 ----
# 指定配置文件路径，替代 ./config/config.toml
READING_CONFIG=
