// 广学五题坊 · 阅读收集（云端版）
// 数据全部存在 PostgreSQL，不再依赖 Obsidian / Notion。
// 约定与「作文积累本」（gxwtf/writing）保持一致：User 预留自增主键 + 广学账号 userId 唯一键。

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 用户（登录时从广学账号 SSO 同步；userId 即广学账号用户 ID）
model User {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  userName    String
  admin       Int      @default(0)
  email       String?
  realName    String?
  /// 用户自带模型（BYOK）：{ mode: 'system' | 'custom', apiBase?, apiKey?, model? }
  aiSettings  Json?
  /// 偏好：{ preciseVideo?: boolean }
  prefs       Json?
  /// 各站登录态：{ zhihu?: string, bilibili?: string, weibo?: string, xiaohongshu?: string }
  credentials Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entries     Entry[]
  collections Collection[]
  highlights  Highlight[]
  keyframes   Keyframe[]
  feeds       Feed[]
  tagConfigs  TagConfig[]
}

/// 收集分组（一个用户可以有多个，例如「待读」「语文素材」「英语外刊」）
model Collection {
  id          Int      @id @default(autoincrement())
  userId      Int
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User              @relation(fields: [userId], references: [userId], onDelete: Cascade)
  entries CollectionEntry[]

  @@unique([userId, name])
  @@index([userId])
}

/// 收集分组 ↔ 条目 多对多
model CollectionEntry {
  id           Int      @id @default(autoincrement())
  collectionId Int
  entryId      Int
  createdAt    DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  entry      Entry      @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([collectionId, entryId])
  @@index([entryId])
}

/// 一条收藏（文章 / 视频 / 播客）
/// state 是「抓取处理状态」，readState 是「阅读进度」，两者独立。
model Entry {
  id          Int       @id @default(autoincrement())
  userId      Int
  url         String    @db.Text
  /// url 的 sha256（hex），用于唯一索引——URL 可能很长，直接给 url 建索引会超出 btree 限制
  urlHash     String    @db.VarChar(64)
  title       String    @db.VarChar(500)
  /// 来源站名，如「微信公众号」「哔哩哔哩」「NYT」
  site        String?   @db.VarChar(100)
  author      String?   @db.VarChar(200)
  /// article | video | podcast
  kind        String    @default("article") @db.VarChar(20)
  lang        String?   @db.VarChar(20)
  excerpt     String?   @db.Text
  /// 清洗后的正文 Markdown（文章正文；视频为空，正文看 Transcript）
  contentMd   String?   @db.Text
  /// 自动概括（要点列表，Markdown）
  summary     String?   @db.Text
  /// 公开分享令牌（只读页面 /s/<token>），为空表示未分享
  shareToken  String?   @unique
  /// 精确播放：本地转码后的 mp4 状态 none | pending | ready | failed
  mediaState  String    @default("none") @db.VarChar(20)
  mediaPath   String?   @db.VarChar(500)
  mediaError  String?   @db.Text
  coverImage  String?   @db.VarChar(2048)
  wordCount   Int?
  durationSec Int?
  publishedAt DateTime?
  /// pending（待抓取）| ready（可用）| failed（抓取失败）
  state       String    @default("pending") @db.VarChar(20)
  /// unread | reading | done
  readState   String    @default("unread") @db.VarChar(20)
  favorite    Boolean   @default(false)
  rating      Int?
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User              @relation(fields: [userId], references: [userId], onDelete: Cascade)
  tags        EntryTag[]
  collections CollectionEntry[]
  transcript  Transcript?
  highlights  Highlight[]
  keyframes   Keyframe[]
  jobs        FetchJob[]

  @@unique([userId, urlHash])
  @@index([userId, state])
  @@index([userId, readState])
  @@index([userId, createdAt])
  @@index([userId, favorite])
}

/// 标签（全局去重，按名称唯一；颜色/描述在 TagConfig 里按用户区分）
model Tag {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  colorId     String   @default("blue")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entryTags EntryTag[]
}

model EntryTag {
  id        Int      @id @default(autoincrement())
  entryId   Int
  tagId     Int
  createdAt DateTime @default(now())

  entry Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([entryId, tagId])
  @@index([tagId])
}

/// 用户级标签配置（颜色、描述），与全局 Tag 名称一一对应
model TagConfig {
  id          Int      @id @default(autoincrement())
  userId      Int
  name        String
  colorId     String   @default("blue")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

/// 音视频逐字稿（一条收藏至多一份）
model Transcript {
  id        Int      @id @default(autoincrement())
  entryId   Int      @unique
  /// 识别语言，必须与原声一致
  locale    String   @db.VarChar(20)
  /// whispercpp | apple | whisper
  backend   String   @db.VarChar(20)
  model     String?  @db.VarChar(100)
  text      String   @db.Text
  /// 带时间戳的分段，形如 [{start, end, text}]
  segments  Json?
  createdAt DateTime @default(now())

  entry Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)
}

/// 划线与批注
model Highlight {
  id        Int      @id @default(autoincrement())
  entryId   Int
  userId    Int
  quote     String   @db.Text
  note      String?  @db.Text
  /// 定位信息（段落序号、字符偏移等），便于在正文里回显
  anchor    Json?
  createdAt DateTime @default(now())

  entry Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([entryId])
  @@index([userId])
}

/// 视频关键帧（用户手动标记的关键时刻）
model Keyframe {
  id        Int      @id @default(autoincrement())
  entryId   Int
  userId    Int
  timeSec   Float
  note      String?  @db.VarChar(200)
  createdAt DateTime @default(now())

  entry Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([entryId])
}

/// RSS 订阅：定时拉取新条目并入库
model Feed {
  id            Int       @id @default(autoincrement())
  userId        Int
  url           String    @db.Text
  title         String?   @db.VarChar(200)
  enabled       Boolean   @default(true)
  lastCheckedAt DateTime?
  lastError     String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, url])
  @@index([enabled, lastCheckedAt])
}

/// 抓取 / 转写任务队列：Web 端只建任务，Python worker 轮询领取
model FetchJob {
  id         Int       @id @default(autoincrement())
  entryId    Int?
  url        String    @db.Text
  /// fetch（抓正文）| transcribe（转写音视频）
  kind       String    @default("fetch") @db.VarChar(20)
  /// pending | running | done | failed
  status     String    @default("pending") @db.VarChar(20)
  attempts   Int       @default(0)
  error      String?   @db.Text
  worker     String?   @db.VarChar(100)
  claimedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  entry Entry? @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([entryId])
}

/// ── Readest / Grimmory 同步 ─────────────────────────────────────────────
/// 书库里的书（文件放在 READEST_BOOKS_DIR，由 WebDAV 服务对外提供）
model Book {
  id           Int       @id @default(autoincrement())
  userId       Int
  /// 相对 READEST_BOOKS_DIR 的路径，唯一
  fileName     String    @unique
  title        String
  author       String?
  /// epub | pdf | cbz | mobi | azw3 | fb2
  format       String
  /// 文件字节数（Readest 用 fileSizeKb = fileSize / 1024 向下取整匹配）
  fileSize     BigInt
  readStatus   String?
  epubCfi      String?
  epubHref     String?
  epubPercent  Float?
  pdfPage      Int?
  pdfPercent   Float?
  lastReadTime DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  annotations BookAnnotation[]
  bookmarks   BookBookmark[]
  sessions    ReadingSession[]

  @@index([userId])
}

/// 划线 / 标注（Readest 的 annotation）
model BookAnnotation {
  id           Int      @id @default(autoincrement())
  bookId       Int
  book         Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  cfi          String
  text         String
  color        String?
  /// highlight | underline | strikethrough | squiggly
  style        String?
  note         String?
  chapterTitle String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([bookId, cfi, text])
  @@index([bookId])
}

/// 书签
model BookBookmark {
  id         Int      @id @default(autoincrement())
  bookId     Int
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  cfi        String?
  pageNumber Int?
  title      String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([bookId])
}

/// 阅读会话（Readest 每次阅读上报一条）
model ReadingSession {
  id              Int      @id @default(autoincrement())
  bookId          Int
  book            Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  startTime       DateTime
  endTime         DateTime
  durationSeconds Int
  startProgress   Float?
  endProgress     Float?
  createdAt       DateTime @default(now())

  @@index([bookId])
}
